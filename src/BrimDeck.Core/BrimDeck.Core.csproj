<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in panel themes and the custom-theme template; see PanelThemes. -->
    <!-- Fixed resource names: a built-in theme's id is its file name (PanelThemes.BuiltInIndex). -->
    <EmbeddedResource Include="Themes\*.json" LogicalName="BrimDeck.Core.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Templates\theme-template.json" LogicalName="BrimDeck.Core.Templates.theme-template.json" />
    <!-- Release notes for the What's new window; see ReleaseHistory. The file name is the version. -->
    <EmbeddedResource Include="..\..\releases\*.md" LogicalName="BrimDeck.Core.Releases.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- Mail over IMAP: the mailbox readers. MailKit brings IDLE, BODYSTRUCTURE and BODY.PEEK[], and MimeKit the
         multipart parsing; the panels read only the text parts, so an attachment is never downloaded. -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <!-- iCalendar, for the work calendars: the event model, the recurrence rules and the time zones. -->
    <PackageReference Include="Ical.Net" Version="5.2.4" />
  </ItemGroup>

</Project>
